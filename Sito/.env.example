VITE_GOOGLE_MAPS_API_KEY=
VITE_ELFSIGHT_REVIEWS_WIDGET_ID=

# L'anteprima resta esclusa dai risultati di ricerca.
VITE_PUBLIC_PREVIEW=true
# Origine HTTPS del dominio definitivo, da configurare al lancio.
VITE_SITE_ORIGIN=

# Facoltativo. Solo il contenuto del meta tag fornito da Search Console.
VITE_GOOGLE_SITE_VERIFICATION=

# GA4 richiede anche il consenso statistico del visitatore, comunicato dalla CMP.
# Impostare true soltanto dopo l'autorizzazione aziendale e la verifica della CMP.
VITE_GA4_AUTHORIZED=false
VITE_GA4_MEASUREMENT_ID=
